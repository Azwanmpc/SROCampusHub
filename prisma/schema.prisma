generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role: SUPERADMIN | ADMIN | PEMOHON | PENGADU
// BookingStatus: MENUNGGU | DISAHKAN | DITOLAK | DIBATALKAN
// FacilityStatus: TERSEDIA | DITEMPAH | PENYELENGGARAAN
// ComplaintStatus: BARU | DALAM_TINDAKAN | SELESAI
// RepairType: DALAMAN | KONTRAKTOR
// ArrangementStyle: ROUND_TABLE | CLASSROOM | SEMINAR | THEATER | U_SHAPE | TIADA
// SQLite connector has no native enum support, so these are validated as strings at the app layer (see src/lib/validation.ts).

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String   @unique
  phone        String?
  passwordHash String
  role         String   @default("PEMOHON")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings            Booking[]
  complaints          Complaint[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  pinjamanAset        PinjamanAset[]
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  type        String
  capacity    Int
  description String?
  imageUrl    String?
  status      String   @default("TERSEDIA")
  costPerUse  Float    @default(0)
  halfDayRate Float?
  fullDayRate Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings   Booking[]
  complaints Complaint[]
}

model Booking {
  id                 String    @id @default(cuid())
  facilityId         String
  facility           Facility  @relation(fields: [facilityId], references: [id])
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  startDateTime      DateTime
  endDateTime        DateTime
  purpose            String
  participantCount   Int
  arrangement        String    @default("TIADA")
  addOnProjector     Int       @default(0)
  addOnTv100         Int       @default(0)
  earlyAccess        Boolean   @default(false)
  earlyAccessMinutes Int       @default(0)
  status             String    @default("MENUNGGU")
  rejectionReason    String?
  checkInAt          DateTime?
  checkOutAt         DateTime?
  roomNumber         String?
  revenue            Float     @default(0)
  organisasi         String?
  alamatOrganisasi   String?
  sebutNama          String?
  sebutTel           String?
  sebutEmel          String?
  addonsJson         String?
  asramaRoomsJson    String?
  quotationNumber    String?
  finalPrice         Float?
  discount           Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  notifications Notification[]
}

model Complaint {
  id          String    @id @default(cuid())
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  guestName   String?
  guestPhone  String?
  location    String
  description String
  photoUrl    String?
  status             String    @default("BARU")
  repairType         String?
  priority           String    @default("SEDERHANA")
  category           String?
  staffNote          String?
  estimatedCost      Float     @default(0)
  confirmationStatus String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  channel   String    @default("whatsapp")
  type      String
  message   String
  sent      Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model HasilSewaan {
  id              String   @id @default(cuid())
  tarikh          DateTime
  organisasi      String
  lokasi          String
  bilanganPeserta Float    @default(0)
  hasilTerimaan   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// jenis: PEMBAIKAN | PENYELENGGARAAN
// tugasDilaksanakan: DALAMAN | KONTRAKTOR
// kategori: ELEKTRIK | AIR_PLUMBING | PENGHAWA_DINGIN | BANGUNAN_STRUKTUR | PERABOT | ICT_RANGKAIAN | AUDIO_VISUAL | PERALATAN | LAIN_LAIN
// lokasi: BANGUNAN_PENTADBIRAN_1 | BANGUNAN_PENTADBIRAN_2 | BILIK_LATIHAN_ICC | BILIK_LATIHAN_TQM | SURAU | ASRAMA | AUDITORIUM | DEWAN_PRODUKTIVITI | LAIN_LAIN
model KosPenyelenggaraan {
  id                String   @id @default(cuid())
  tarikh            DateTime
  lokasi            String
  perincianLokasi   String?
  jenis             String
  butiranKerja      String
  kos               Float    @default(0)
  tugasDilaksanakan String
  kategori          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// status: BAIK | ROSAK
model Aset {
  id             String   @id @default(cuid())
  namaAset       String
  noPendaftaran  String
  tahun          String?
  lokasi         String
  status         String   @default("BAIK")
  sedangDipinjam Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pinjamanItems PinjamanAsetItem[]
}

// status: MENUNGGU_KELULUSAN | DITOLAK | DILULUSKAN | DIPULANGKAN | SELESAI
// KEW.PA-9 Borang Permohonan Pergerakan/Pinjaman Aset Alih
model PinjamanAset {
  id                   String    @id @default(cuid())
  pemohonId            String
  pemohon              User      @relation(fields: [pemohonId], references: [id])
  jawatan              String
  bahagian             String
  tujuan               String
  tempatDigunakan      String
  status               String    @default("MENUNGGU_KELULUSAN")
  tarikhDijangkaPulang DateTime
  tarikhLulus          DateTime?
  tarikhDipinjam       DateTime?
  tarikhDipulangkan    DateTime?
  tarikhDiterima       DateTime?
  pelulusNama          String?
  pelulusJawatan       String?
  pemulangNama         String?
  pemulangJawatan      String?
  penerimaNama         String?
  penerimaJawatan      String?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items PinjamanAsetItem[]
}

model PinjamanAsetItem {
  id         String       @id @default(cuid())
  pinjamanId String
  pinjaman   PinjamanAset @relation(fields: [pinjamanId], references: [id], onDelete: Cascade)
  asetId     String
  aset       Aset         @relation(fields: [asetId], references: [id])
}
